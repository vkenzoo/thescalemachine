# =====================================================================
# Ad Manager — variáveis de ambiente
# Copie para .env.local e preencha. Nunca commite .env.
# =====================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase (Fase 1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Meta — System User Token mode (MVP)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# Criptografia de tokens (AES-256-GCM)
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Cron auth — Vercel Cron passa no header Authorization: Bearer ...
# Gere com: openssl rand -base64 32
CRON_SECRET=

# Asaas (Fase 6)
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# Resend (e-mails transacionais)
RESEND_API_KEY=

# Sentry (observabilidade — só ativa em prod)
# Pega no dashboard sentry.io: Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Pra upload de sourcemaps no build (opcional mas recomendado pra stack traces legíveis):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Worker de upload (Fase 2)
UPLOAD_WORKER_URL=http://localhost:3001
UPSTASH_REDIS_URL=
